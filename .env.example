# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser commitado (já está no .gitignore).

# String de conexão do banco. Se não definir, o projeto usa SQLite local
# (sqlite:///./ryzer.db), ótimo para rodar e demonstrar sem infraestrutura.
# Para Postgres em produção, algo como:
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require
# DATABASE_URL=sqlite:///./ryzer.db

# Chave usada para assinar os tokens JWT. Se não definir, uma chave aleatória
# é gerada a cada execução (tokens emitidos antes de reiniciar o servidor
# deixam de funcionar). Em produção, defina um valor fixo e secreto:
# gere um com: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
